# auto-paired brackets, [[link suggestions, fence auto-close, quote continuation (see tests/ui/assist.sh)
wait 500
key ctrl-end
type f(x
state
type )
state
type  (
key backspace
state
key enter
type [[gra
wait 200
suggest
state
key enter
wait 100
state
type  [[Grafi#cam
wait 200
suggest
key tab
wait 100
state
type  [[al
wait 200
key escape
wait 100
suggest
key ctrl-end
key enter
type ```
state
key down
state
key ctrl-end
key enter
key enter
type > quoted
key enter
state
key enter
state
quit
